<svg width="800" height="450" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="800" height="450" fill="#f7f7f7"/>
  
  <!-- Browser Window -->
  <rect x="50" y="50" width="700" height="350" rx="8" fill="white" stroke="#e0e0e0" stroke-width="2"/>
  <rect x="50" y="50" width="700" height="40" rx="8" fill="#f0f0f0"/>
  <circle cx="70" cy="70" r="6" fill="#ff5f56"/>
  <circle cx="90" cy="70" r="6" fill="#ffbd2e"/>
  <circle cx="110" cy="70" r="6" fill="#27c93f"/>
  
  <!-- URL Bar -->
  <rect x="150" y="60" width="450" height="20" rx="10" fill="white" stroke="#d0d0d0"/>
  <text x="170" y="75" font-family="Inter, sans-serif" font-size="12" fill="#666">https://example.com/product</text>
  
  <!-- Content Area -->
  <rect x="80" y="120" width="640" height="40" rx="4" fill="#e8e8e8"/>
  <rect x="80" y="175" width="300" height="15" rx="3" fill="#d0d0d0"/>
  <rect x="80" y="200" width="400" height="15" rx="3" fill="#d0d0d0"/>
  <rect x="80" y="225" width="350" height="15" rx="3" fill="#d0d0d0"/>
  
  <!-- Arrow pointing to Notion -->
  <path d="M 400 280 L 400 320" stroke="#000" stroke-width="3" fill="none" marker-end="url(#arrowhead)"/>
  <defs>
    <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="5" refY="5" orient="auto">
      <polygon points="0 0, 10 5, 0 10" fill="#000"/>
    </marker>
  </defs>
  
  <!-- Notion Logo Icon -->
  <rect x="350" y="330" width="100" height="50" rx="4" fill="#000"/>
  <text x="400" y="360" font-family="Inter, sans-serif" font-size="16" fill="white" text-anchor="middle" font-weight="bold">Notion</text>
  
  <!-- Click indicator -->
  <text x="400" y="150" font-family="Inter, sans-serif" font-size="14" fill="#5e5e5e" text-anchor="middle" font-weight="600">One Click Import →</text>
  
  <!-- Animated pulse (simulated) -->
  <circle cx="400" cy="280" r="10" fill="#27c93f" opacity="0.6"/>
</svg>
